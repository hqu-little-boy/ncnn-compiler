# 由 CMake 从 lit.site.cfg.py.in 生成（configure_file @ONLY），勿手改。
# 注入工具路径与源/构建目录，再加载源码树里的 lit.cfg.py。

import os

config.ncnn_mlir_tools_dir = "@CMAKE_BINARY_DIR@/bin"
config.ncnn_mlir_driver = "@CMAKE_BINARY_DIR@/tools/ncnn-mlir-driver"
config.filecheck = "@FILECHECK@"
config.mlir_opt = "@MLIR_OPT@"
config.squeezenet_param = "@CMAKE_CURRENT_SOURCE_DIR@/third_party/ncnn/examples/squeezenet_v1.1.param"
config.squeezenet_bin = "@CMAKE_CURRENT_SOURCE_DIR@/third_party/ncnn/examples/squeezenet_v1.1.bin"
ncnn_test_llvm_library_dir = "@NCNN_TEST_LLVM_LIBRARY_DIR@"
if ncnn_test_llvm_library_dir:
    inherited_library_path = config.environment.get("LD_LIBRARY_PATH", "")
    library_paths = [ncnn_test_llvm_library_dir]
    if inherited_library_path:
        library_paths.append(inherited_library_path)
    config.environment["LD_LIBRARY_PATH"] = os.pathsep.join(library_paths)

config.test_source_root = "@CMAKE_CURRENT_SOURCE_DIR@"
config.test_exec_root = "@CMAKE_CURRENT_BINARY_DIR@"

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
