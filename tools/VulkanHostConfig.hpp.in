#pragma once

#include <array>
#include <string_view>

namespace ncnn_compile::vulkan_host_config {

// VA5 deployment boundary: the generated model library links only the
// fixed-run host object, the device helper archive, and platform/Vulkan
// libraries.  Compiler LLVM linkage (shared or static) is intentionally not
// represented here because it can no longer leak into the model artifact.
inline constexpr bool kHostCxxCompilerIsClang =
  @NCNN_VULKAN_HOST_CXX_COMPILER_IS_CLANG@;
inline constexpr std::string_view kSanitizerRuntimeDir = @NCNN_VULKAN_SANITIZER_RUNTIME_DIR_CPP@;
inline constexpr std::string_view kAddressSanitizerRuntime = @NCNN_VULKAN_ASAN_RUNTIME_CPP@;
inline constexpr std::array<std::string_view, @NCNN_VULKAN_HOST_SANITIZER_ARGS_COUNT@>
  kHostSanitizerArgs{@NCNN_VULKAN_HOST_SANITIZER_ARGS_CPP@};
inline constexpr std::array<std::string_view, @NCNN_VULKAN_HOST_CXX_FLAGS_COUNT@>
  kHostCxxFlags{@NCNN_VULKAN_HOST_CXX_FLAGS_CPP@};
inline constexpr std::array<std::string_view, @NCNN_VULKAN_HOST_CXX_RUNTIME_ARGS_COUNT@>
  kHostCxxRuntimeArgs{@NCNN_VULKAN_HOST_CXX_RUNTIME_ARGS_CPP@};
inline constexpr std::array<std::string_view, @NCNN_VULKAN_SANITIZER_NEEDED_LIBRARIES_COUNT@>
  kSanitizerNeededLibraries{@NCNN_VULKAN_SANITIZER_NEEDED_LIBRARIES_CPP@};
inline constexpr std::array<std::string_view, @NCNN_VULKAN_SANITIZER_RUNTIME_LIBRARIES_COUNT@>
  kSanitizerRuntimeLibraries{@NCNN_VULKAN_SANITIZER_RUNTIME_LIBRARIES_CPP@};

}  // namespace ncnn_compile::vulkan_host_config
